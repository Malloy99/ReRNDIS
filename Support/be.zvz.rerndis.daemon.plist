<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>be.zvz.rerndis.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/be.zvz.rerndis.daemon</string>
		<string>run</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>be.zvz.rerndis.xpc</key>
		<true/>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<!-- The daemon carries the user's live network traffic. Without this,
	     launchd's daemon resource controls decay the busy pipeline threads
	     into the utility band (thread priority 20 observed; 37 with
	     Interactive, matching a foreground run of the same binary). -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/rerndis.log</string>
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>4096</integer>
	</dict>
</dict>
</plist>
